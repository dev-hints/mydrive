# ==========================================
# MyDrive Configuration Example
# Copy this file to .env and configure values
# ==========================================

APP_NAME=MyDrive
HOST=0.0.0.0
PORT=8080
DEBUG=false

# ==========================================
# Storage & Directory Settings
# ==========================================
# Can be a relative path or an absolute path (e.g., /mnt/storage or /storage/emulated/0/MyDrive)
STORAGE_ROOT=data/storage
DATABASE_PATH=data/mydrive.db
TEMP_UPLOAD_DIR=data/uploads_temp
TRASH_DIR=data/trash
AVATARS_DIR=data/avatars

# ==========================================
# Security & Authentication
# ==========================================
# Generate random 32-byte hex keys: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SESSION_SECRET_32_BYTES_HEX
CSRF_SECRET=REPLACE_WITH_A_SECURE_RANDOM_CSRF_SECRET_32_BYTES_HEX
# Set COOKIE_SECURE=true when serving over HTTPS/TLS
COOKIE_SECURE=false

# ==========================================
# Storage Quotas & Upload Parameters
# ==========================================
MAX_UPLOAD_SIZE=10737418240         # 10 GB max upload file size in bytes
CHUNK_SIZE=4194304                   # 4 MB chunk slice size in bytes
SESSION_LIFETIME_DAYS=30            # Session validity window in days
DEFAULT_USER_QUOTA_BYTES=5368709120 # 5 GB default quota for self-registered users (0 = unlimited)

# ==========================================
# Rate Limiting & Brute-Force Defense
# ==========================================
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOCKOUT_MINUTES=15

# ==========================================
# Policies & Logging
# ==========================================
SHOW_HIDDEN_FILES=false
ENABLE_DOCS=false
LOG_LEVEL=INFO
